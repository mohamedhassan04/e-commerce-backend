# Public application URL and frontend origin
PORT=8080
NODE_ENV=production
MODE=PROD
PREFIX=api
FRONTEND_PATH=https://www.mamolej.cz
BACKEND_URL=https://www.mamolej.cz

# Database (use a unique strong password)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=mamolej
POSTGRES_PASSWORD=replace-with-a-long-random-secret
POSTGRES_DATABASE=mamolej
POSTGRES_DB=mamolej

# JWT secrets (generate independent random values)
JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-another-long-random-secret
JWT_EXPIRES_IN=15m

# Mail provider
MAIL_HOST=smtp.example.com
MAIL_USER=replace-me
MAIL_PASS=replace-me
MAIL_SMTP_PORT=465
DEFAULT_MAIL_FROM="Mamolej <no-reply@example.com>"

# Admin notification recipient (withdraw requests, etc.)
ADMIN_EMAIL=admin@example.com

# Rate limiting
THROTTLER_TTL=60000
THROTTLER_LIMIT=100

# Swagger configuration
SWAGGER_PATH=docs/v1
SWAGGER_TITLE=Mamolej API
SWAGGER_DESCRIPTION=Mamolej e-commerce API
SWAGGER_VERSION=1.0.0
SWAGGER_SCHEME=https
